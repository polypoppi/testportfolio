---
import Base from '../../../layouts/Base.astro';
import { getStoryBySlug, getChapters } from '../../../lib/db';

const story = await getStoryBySlug(Astro.params.story!);
const chapters = story ? await getChapters(story.id) : [];
const index = chapters.findIndex((c) => c.slug === Astro.params.chapter);
if (!story || index < 0) return new Response(null, { status: 404 });
const chapter = chapters[index];
const prev = chapters[index - 1];
const next = chapters[index + 1];
const minutes = Math.max(1, Math.round(chapter.words / 220));
---

<Base title={`${chapter.title} · ${story.title}`}>
  <div class="progress" aria-hidden="true"><span id="bar"></span></div>
  <article class="reader">
    <a class="back mono" href={`/writing/${story.slug}`}>← {story.title}</a>
    <p class="eyebrow">Chapter {index + 1} of {chapters.length} · {minutes} min read</p>
    <h1>{chapter.title}</h1>
    <div class="prose" set:html={chapter.body} />

    <nav class="pager" aria-label="Chapters">
      {
        prev ? (
          <a href={`/writing/${story.slug}/${prev.slug}`} class="prev">
            <span class="eyebrow">Previous</span>
            {prev.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a href={`/writing/${story.slug}/${next.slug}`} class="next">
            <span class="eyebrow">Next</span>
            {next.title}
          </a>
        ) : (
          <a href={`/writing/${story.slug}`} class="next">
            <span class="eyebrow">The end, for now</span>
            Back to contents
          </a>
        )
      }
    </nav>
  </article>
</Base>

<script>
  const bar = document.getElementById('bar');
  const update = () => {
    const max = document.documentElement.scrollHeight - innerHeight;
    if (bar) bar.style.width = `${max > 0 ? (scrollY / max) * 100 : 100}%`;
  };
  addEventListener('scroll', update, { passive: true });
  update();
</script>

<style>
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 10;
  }

  .progress span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--accent);
  }

  .reader {
    max-width: 680px;
    margin: 0 auto;
    padding-top: 12px;
  }

  .back {
    display: inline-block;
    margin-bottom: 32px;
    font-size: 14px;
    text-decoration: none;
    color: var(--ink-2);
  }

  h1 {
    font-family: var(--font-serif);
    font-size: clamp(32px, 5vw, 46px);
    font-weight: 600;
    margin: 10px 0 36px;
  }

  .prose {
    font-family: var(--font-serif);
    font-size: 20px;
    line-height: 1.8;
  }

  .prose :global(p) {
    margin: 0 0 1.3em;
  }

  .prose :global(h2),
  .prose :global(h3) {
    font-family: var(--font-serif);
    margin: 1.6em 0 0.6em;
  }

  .prose :global(blockquote) {
    margin: 1.5em 0;
    padding-left: 1.2em;
    border-left: 3px solid var(--accent);
    font-style: italic;
  }

  .prose :global(hr) {
    border: 0;
    text-align: center;
    margin: 2.4em 0;
  }

  .prose :global(hr)::after {
    content: '✦  ✦  ✦';
    color: var(--ink-3);
    letter-spacing: 0.4em;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .pager a {
    display: grid;
    gap: 4px;
    padding: 16px 18px;
    border-radius: 16px;
    text-decoration: none;
    font-weight: 600;
    background: var(--card);
    border: 1.5px solid var(--line);
  }

  .pager a:hover {
    border-color: var(--accent);
  }

  .next {
    text-align: right;
  }

  @media (max-width: 560px) {
    .prose {
      font-size: 18px;
    }
  }
</style>
