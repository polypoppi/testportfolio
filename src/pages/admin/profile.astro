---
import Admin from '../../layouts/Admin.astro';
import { getSettings, setSetting } from '../../lib/db';

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const s = (k: string) => String(fd.get(k) ?? '').trim();
  const all = (k: string) => fd.getAll(k).map((v) => String(v).trim());
  const name = s('name');

  await setSetting('profile', {
    name,
    fullName: s('fullName'),
    firstName: s('firstName') || name.split(' ')[0],
    initials: s('initials') || name.split(/\s+/).map((w) => w[0]).join('').slice(0, 2).toUpperCase(),
    title: s('title'),
    role: s('role'),
    company: s('company'),
    location: s('location'),
    since: Number(s('since')) || new Date().getFullYear(),
    email: s('email'),
    linkedin: s('linkedin'),
    github: s('github'),
    photo: s('photo'),
    intro: s('intro'),
  });

  const hv = all('h_value'), hu = all('h_unit'), hl = all('h_label');
  await setSetting('highlights', hv.map((value, i) => ({ value, unit: hu[i] ?? '', label: hl[i] ?? '' })).filter((h) => h.value || h.label));

  const tc = all('t_code'), tn = all('t_name');
  await setSetting('tools', tc.map((code, i) => ({ code: code.slice(0, 3), name: tn[i] ?? '' })).filter((t) => t.code));

  const gn = all('g_name'), gi = all('g_items');
  await setSetting(
    'skills',
    gn
      .map((name, i) => ({ name, items: (gi[i] ?? '').split('\n').map((x) => x.trim()).filter(Boolean) }))
      .filter((g) => g.name || g.items.length),
  );

  const et = all('e_title'), es = all('e_school'), ey = all('e_years');
  await setSetting('education', et.map((title, i) => ({ title, school: es[i] ?? '', years: ey[i] ?? '' })).filter((e) => e.title));

  await setSetting('certifications', s('certifications').split('\n').map((x) => x.trim()).filter(Boolean));

  return Astro.redirect('/admin/profile?saved=1');
}

const { profile: p, highlights, tools, skills, education, certifications } = await getSettings();
---

<Admin title="Profile & skills">
  <div class="a-head">
    <div>
      <h1>Profile & skills</h1>
      <p>Your name, intro, photo and everything on the Home, Experience and About pages that isn’t a job or project.</p>
    </div>
  </div>

  <form method="post">
    <section class="panel">
      <h2>About you</h2>
      <p class="hint">Shown in the sidebar, the home page and the About page.</p>
      <div class="field">
        <span>Photo</span>
        <div class="upload" data-upload>
          <img alt="" hidden />
          <input type="hidden" name="photo" value={p.photo} />
          <div>
            <input type="file" accept="image/*" />
            <p class="up-status">A square photo works best.</p>
            <button class="linkish" data-clear hidden>Remove photo</button>
          </div>
        </div>
      </div>
      <div class="grid-2">
        <label class="field"><span>Display name</span><input type="text" name="name" value={p.name} required /></label>
        <label class="field"><span>Full name</span><input type="text" name="fullName" value={p.fullName} /></label>
        <label class="field"><span>First name <small class="hint">(used in “Hi, I’m …”)</small></span><input type="text" name="firstName" value={p.firstName} /></label>
        <label class="field"><span>Initials <small class="hint">(shown when there’s no photo)</small></span><input type="text" name="initials" value={p.initials} maxlength="3" /></label>
        <label class="field"><span>Headline</span><input type="text" name="title" value={p.title} /></label>
        <label class="field"><span>Location</span><input type="text" name="location" value={p.location} /></label>
        <label class="field"><span>Current role</span><input type="text" name="role" value={p.role} /></label>
        <label class="field"><span>Current company</span><input type="text" name="company" value={p.company} /></label>
        <label class="field"><span>Working since <small class="hint">(year)</small></span><input type="number" name="since" value={p.since} min="1950" max="2100" /></label>
      </div>
      <label class="field">
        <span>Short intro</span>
        <textarea name="intro" rows="3">{p.intro}</textarea>
      </label>
    </section>

    <section class="panel">
      <h2>Contact links</h2>
      <p class="hint">Shown as icons in the sidebar. Your phone number is never shown.</p>
      <div class="grid-3">
        <label class="field"><span>Email</span><input type="email" name="email" value={p.email} /></label>
        <label class="field"><span>LinkedIn URL</span><input type="url" name="linkedin" value={p.linkedin} /></label>
        <label class="field"><span>GitHub URL</span><input type="url" name="github" value={p.github} /></label>
      </div>
    </section>

    <section class="panel">
      <h2>Highlights</h2>
      <p class="hint">The big numbers under “Currently” on the home page.</p>
      <div id="highlights">
        {
          highlights.map((h) => (
            <div class="row hl" data-row>
              <label class="field"><span>Number</span><input type="text" name="h_value" value={h.value} /></label>
              <label class="field"><span>Unit</span><input type="text" name="h_unit" value={h.unit} placeholder="yrs" /></label>
              <label class="field"><span>Label</span><input type="text" name="h_label" value={h.label} /></label>
              <button class="danger small" data-remove title="Remove">✕</button>
            </div>
          ))
        }
      </div>
      <button class="small" data-add="tpl-hl" data-into="#highlights">+ Add highlight</button>
      <template id="tpl-hl">
        <div class="row hl" data-row>
          <label class="field"><span>Number</span><input type="text" name="h_value" /></label>
          <label class="field"><span>Unit</span><input type="text" name="h_unit" placeholder="yrs" /></label>
          <label class="field"><span>Label</span><input type="text" name="h_label" /></label>
          <button class="danger small" data-remove title="Remove">✕</button>
        </div>
      </template>
    </section>

    <section class="panel">
      <h2>Floating tool tiles</h2>
      <p class="hint">The little tiles around the boarding pass on the home page. Up to 8 are shown; the code is 1–3 letters.</p>
      <div id="tools" class="tools">
        {
          tools.map((t) => (
            <div class="row tl" data-row>
              <input type="text" name="t_code" value={t.code} maxlength="3" aria-label="Code" />
              <input type="text" name="t_name" value={t.name} aria-label="Tool name" />
              <button class="danger small" data-remove title="Remove">✕</button>
            </div>
          ))
        }
      </div>
      <button class="small" data-add="tpl-tl" data-into="#tools">+ Add tool</button>
      <template id="tpl-tl">
        <div class="row tl" data-row>
          <input type="text" name="t_code" maxlength="3" aria-label="Code" placeholder="PA" />
          <input type="text" name="t_name" aria-label="Tool name" placeholder="Power Apps" />
          <button class="danger small" data-remove title="Remove">✕</button>
        </div>
      </template>
    </section>

    <section class="panel">
      <h2>Skills</h2>
      <p class="hint">Groups of skills on the Experience page. One skill per line.</p>
      <div id="skills" class="skill-grid">
        {
          skills.map((g) => (
            <div class="row" data-row>
              <label class="field"><span>Group</span><input type="text" name="g_name" value={g.name} /></label>
              <label class="field"><span>Skills</span><textarea name="g_items" rows="6">{g.items.join('\n')}</textarea></label>
              <button class="danger small" data-remove>Remove group</button>
            </div>
          ))
        }
      </div>
      <button class="small" data-add="tpl-sk" data-into="#skills">+ Add group</button>
      <template id="tpl-sk">
        <div class="row" data-row>
          <label class="field"><span>Group</span><input type="text" name="g_name" /></label>
          <label class="field"><span>Skills</span><textarea name="g_items" rows="6"></textarea></label>
          <button class="danger small" data-remove>Remove group</button>
        </div>
      </template>
    </section>

    <section class="panel">
      <h2>Education</h2>
      <div id="edu">
        {
          education.map((e) => (
            <div class="row ed" data-row>
              <label class="field"><span>Qualification</span><input type="text" name="e_title" value={e.title} /></label>
              <label class="field"><span>School</span><input type="text" name="e_school" value={e.school} /></label>
              <label class="field"><span>Years</span><input type="text" name="e_years" value={e.years} placeholder="2014 – 2017" /></label>
              <button class="danger small" data-remove title="Remove">✕</button>
            </div>
          ))
        }
      </div>
      <button class="small" data-add="tpl-ed" data-into="#edu">+ Add education</button>
      <template id="tpl-ed">
        <div class="row ed" data-row>
          <label class="field"><span>Qualification</span><input type="text" name="e_title" /></label>
          <label class="field"><span>School</span><input type="text" name="e_school" /></label>
          <label class="field"><span>Years</span><input type="text" name="e_years" placeholder="2014 – 2017" /></label>
          <button class="danger small" data-remove title="Remove">✕</button>
        </div>
      </template>
    </section>

    <section class="panel">
      <h2>Licences & training</h2>
      <label class="field">
        <span>One per line</span>
        <textarea name="certifications" rows="6">{certifications.join('\n')}</textarea>
      </label>
    </section>

    <div class="savebar">
      <button class="primary" type="submit">Save changes</button>
    </div>
  </form>
</Admin>

<style>
  .hl {
    grid-template-columns: 110px 90px minmax(0, 1fr) auto;
    align-items: end;
  }

  .ed {
    grid-template-columns: minmax(0, 2fr) minmax(0, 2fr) minmax(0, 1fr) auto;
    align-items: end;
  }

  .tools {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 0 10px;
  }

  .tl {
    grid-template-columns: 64px minmax(0, 1fr) auto;
    align-items: center;
  }

  .skill-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 0 10px;
  }

  .skill-grid .row button {
    justify-self: start;
  }

  @media (max-width: 640px) {
    .hl,
    .ed {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
