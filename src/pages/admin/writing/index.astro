---
import Admin from '../../../layouts/Admin.astro';
import { db, getStories, slugify } from '../../../lib/db';

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const title = String(fd.get('title') ?? '').trim() || 'Untitled story';
  let slug = slugify(title);
  const clash = await db().prepare('SELECT 1 FROM stories WHERE slug = ?1').bind(slug).first();
  if (clash) slug = `${slug}-${Date.now().toString(36).slice(-4)}`;
  const story = await db()
    .prepare(`INSERT INTO stories (slug, title, position) VALUES (?1, ?2, (SELECT COALESCE(MAX(position),0)+1 FROM stories)) RETURNING id`)
    .bind(slug, title)
    .first<{ id: number }>();
  const ch = await db()
    .prepare(`INSERT INTO chapters (story_id, slug, title, position) VALUES (?1, 'chapter-1', 'Chapter 1', 0) RETURNING id`)
    .bind(story!.id)
    .first<{ id: number }>();
  return Astro.redirect(`/admin/writing/${story!.id}/${ch!.id}`);
}

const stories = await getStories(true);
const words = await db()
  .prepare('SELECT story_id, SUM(words) AS w, SUM(published) AS p FROM chapters GROUP BY story_id')
  .all<{ story_id: number; w: number; p: number }>();
const wmap = new Map(words.results.map((r) => [r.story_id, r]));
---

<Admin title="Writing">
  <div class="a-head">
    <div>
      <h1>Writing</h1>
      <p>Your stories. Drag ⋮⋮ to change the order they appear on the site.</p>
    </div>
  </div>

  <form method="post" class="panel new">
    <label class="field grow">
      <span>Start a new story</span>
      <input type="text" name="title" placeholder="Working title" required />
    </label>
    <button class="primary" type="submit">Create & start writing</button>
  </form>

  <section class="panel">
    {stories.length === 0 && <p class="empty-state">No stories yet. Give one a working title above.</p>}
    <ul class="list" data-sortable="stories">
      {
        stories.map((s) => {
          const w = wmap.get(s.id);
          return (
            <li class="item" data-id={s.id}>
              <span class="handle" title="Drag to reorder">⋮⋮</span>
              <div class="cover-thumb" style={s.cover ? `background-image:url(${s.cover})` : ''} />
              <div class="grow">
                <a class="title" href={`/admin/writing/${s.id}`}>{s.title}</a>
                <span class="sub">
                  {s.chapterCount} {s.chapterCount === 1 ? 'chapter' : 'chapters'} · {(w?.w ?? 0).toLocaleString()} words · {s.status}
                </span>
              </div>
              <span class:list={['badge', { live: s.published }]}>{s.published ? 'On site' : 'Hidden'}</span>
            </li>
          );
        })
      }
    </ul>
  </section>
</Admin>

<script>
  import { initSortable } from '../../../scripts/sortable';
  initSortable();
</script>

<style>
  .new {
    display: flex;
    gap: 12px;
    align-items: flex-end;
    flex-wrap: wrap;
  }

  .new .field {
    margin: 0;
    flex: 1;
    min-width: 220px;
  }

  .cover-thumb {
    width: 36px;
    height: 54px;
    border-radius: 3px 6px 6px 3px;
    background: linear-gradient(160deg, var(--accent-2), var(--accent));
    background-size: cover;
    background-position: center;
    flex-shrink: 0;
  }
</style>
