---
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/db';

const projects = await getProjects();
---

<Base title="Projects">
  <header class="page-head">
    <p class="eyebrow">Hangar</p>
    <h1>Projects</h1>
    <p>Things I have built or put in order to make operations safer and simpler to run.</p>
  </header>

  <div class="grid">
    {
      projects.map((p, i) => (
        <a class="card proj" href={`/projects/${p.slug}`}>
          <span class="num mono">{String(i + 1).padStart(2, '0')}</span>
          <h2>{p.title}</h2>
          <p class="meta mono">{p.org} · {p.year}</p>
          <p>{p.summary}</p>
          <div class="stack">
            {p.stack.map((s) => (
              <span class="chip">{s}</span>
            ))}
          </div>
          <span class="go" aria-hidden="true">→</span>
        </a>
      ))
    }
  </div>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 18px;
    max-width: 1100px;
  }

  .proj {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 24px;
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .proj:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
  }

  .num {
    color: var(--accent);
    font-weight: 600;
  }

  .proj h2 {
    margin-top: 14px;
    font-size: 24px;
  }

  .meta {
    margin: 6px 0 0;
    font-size: 13px;
    color: var(--ink-3);
  }

  .proj p:not(.meta) {
    color: var(--ink-2);
    font-size: 16px;
    flex: 1;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .go {
    position: absolute;
    top: 20px;
    right: 22px;
    font-size: 22px;
    transition: transform 0.2s ease;
  }

  .proj:hover .go {
    transform: translateX(4px);
    color: var(--accent);
  }
</style>
